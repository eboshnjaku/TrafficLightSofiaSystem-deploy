{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=trafficlight.db"
  },
  "Jwt": {
    "Issuer": "TrafficLightSofia",
    "Audience": "TrafficLightSofia",
    "Key": "CHANGE-ME-super-secret-signing-key-of-at-least-32-bytes!!",
    "ExpiryMinutes": 120
  },
  "Device": {
    "Mode": "Simulation",
    "MqttHost": "mosquitto",
    "MqttPort": 1883
  },
  "Defense": {
    "Enabled": false,
    "MaxAttemptsBeforeLockout": 5,
    "LockoutSeconds": 30,
    "PerAttemptDelayMs": 0
  },
  "SecurityLab": {
    "MaxAttempts": 100000000,
    "MaxSeconds": 15,
    "ProgressIntervalMs": 200
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:8080" ]
  }
}
